// Phase 3 starting schema: identity, memberships, tenancy root.
// See docs/plan/08-database-schema.md §8.2 for the full target catalog —
// catalog/inventory/orders/payments/delivery tables land in later phases.
//
// RLS policies are NOT expressed here (Prisma doesn't model them) — they are
// added as raw SQL in a companion migration per table, per §8.6, and are
// what the Phase 3 cross-tenant isolation suite actually tests.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  ACTIVE
  LOCKED
  CLOSED
}

enum PlatformRole {
  SUPER_ADMIN
}

enum MembershipRole {
  STORE_ADMIN
  INVENTORY_MANAGER
  CLERK
  DELIVERY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PermissionEffect {
  GRANT
  DENY
}

enum StoreStatus {
  APPROVED
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BusinessType {
  RETAIL
  RESTAURANT
  SERVICE
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PW_RESET
  INVITE
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique @db.Citext
  passwordHash      String?       @map("password_hash")
  name              String
  phone             String?
  platformRole      PlatformRole? @map("platform_role")
  status            UserStatus    @default(ACTIVE)
  emailVerifiedAt   DateTime?     @map("email_verified_at")
  mfaTotpSecret     String?       @map("mfa_totp_secret")
  lastLoginAt       DateTime?     @map("last_login_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  memberships        StoreMembership[]
  ownedStores        Store[]             @relation("StoreOwner")
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  familyId   String    @map("family_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  rotatedAt  DateTime? @map("rotated_at")
  revokedAt  DateTime? @map("revoked_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Store {
  id                   String       @id @default(uuid())
  slug                 String       @unique @db.Citext
  name                 String
  legalName            String?      @map("legal_name")
  businessType         BusinessType @map("business_type")
  status               StoreStatus  @default(APPROVED)
  ownerUserId          String       @map("owner_user_id")
  addressLine1         String?      @map("address_line1")
  city                 String?
  state                String?
  postalCode           String?      @map("postal_code")
  country              String?
  timezone             String       @default("America/New_York")
  currency             String       @default("USD") @db.Char(3)
  branding             Json         @default("{}")
  stripeAccountId      String?      @unique @map("stripe_account_id")
  stripeChargesEnabled Boolean      @default(false) @map("stripe_charges_enabled")
  cashEnabled          Boolean      @default(true) @map("cash_enabled")

  /// Per-transaction platform fee, in basis points. NULL inherits the plan's rate.
  ///
  /// BBA publicly commits to taking no cut of a store's sales (docs/plan §18.6), so
  /// this is 0 everywhere and `application_fee_amount` is omitted from PaymentIntents
  /// entirely rather than passed as zero — a zero fee still prints a fee line on the
  /// merchant's Stripe statement, which contradicts the promise.
  ///
  /// This lives on the store as well as the plan on purpose: if a per-transaction fee
  /// is ever introduced, every store existing at that moment must be grandfathered at
  /// 0 permanently, and that requires a per-store value no future plan change can
  /// override. Setting this to a non-zero value is a trust decision, not a config one.
  platformFeeBps       Int?         @default(0) @map("platform_fee_bps")
  approvedAt           DateTime?    @map("approved_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  owner       User               @relation("StoreOwner", fields: [ownerUserId], references: [id])
  memberships StoreMembership[]
  hours       StoreHours[]
  taxRates    TaxRate[]

  @@map("stores")
}

model StoreMembership {
  id         String           @id @default(uuid())
  storeId    String           @map("store_id")
  userId     String           @map("user_id")
  role       MembershipRole
  status     MembershipStatus @default(INVITED)
  invitedBy  String?          @map("invited_by")
  acceptedAt DateTime?        @map("accepted_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  store     Store                       @relation(fields: [storeId], references: [id])
  user      User                        @relation(fields: [userId], references: [id])
  overrides MemberPermissionOverride[]

  @@unique([storeId, userId])
  @@index([userId, status])
  @@map("store_memberships")
}

model MemberPermissionOverride {
  id             String           @id @default(uuid())
  membershipId   String           @map("membership_id")
  permissionCode String           @map("permission_code")
  effect         PermissionEffect
  grantedBy      String?          @map("granted_by")
  createdAt      DateTime         @default(now()) @map("created_at")

  membership StoreMembership @relation(fields: [membershipId], references: [id])

  @@unique([membershipId, permissionCode])
  @@map("member_permission_overrides")
}

/// Single-use tokens delivered by email: address verification, password reset,
/// and staff/owner invitations.
///
/// `userId` is nullable because an invitation is sent to an email address that
/// may not have an account yet — the account is created when the invite is
/// accepted. That is also why `email` is stored here rather than being read
/// through the relation.
///
/// Only the SHA-256 hash of the token is stored, for the same reason as refresh
/// tokens: a database read must not yield usable credentials.
model VerificationToken {
  id        String                @id @default(uuid())
  userId    String?               @map("user_id")
  email     String                @db.Citext
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash")

  /// Type-specific data. INVITE carries { storeId, role, invitedBy }.
  payload   Json?

  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([email, type])
  @@map("verification_tokens")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
}

/// Public applications from businesses wanting a store (plan §5.7).
///
/// Deliberately separate from `stores`: an application is a request from a
/// person we know nothing about yet, and most fields are unverified claims.
/// A store row only exists once a human has approved one.
model StoreApplication {
  id            String            @id @default(uuid())
  applicantName String            @map("applicant_name")
  applicantEmail String           @map("applicant_email") @db.Citext
  applicantPhone String?          @map("applicant_phone")
  businessName  String            @map("business_name")
  businessType  BusinessType      @map("business_type")
  addressLine1  String?           @map("address_line1")
  city          String?
  state         String?
  postalCode    String?           @map("postal_code")
  pitch         String?
  status        ApplicationStatus @default(PENDING)
  reviewedBy    String?           @map("reviewed_by")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewNote    String?           @map("review_note")

  /// Set on approval. Also the idempotency guard: a retried approval finds the
  /// store already linked rather than provisioning a second one.
  storeId       String?           @unique @map("store_id")

  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("store_applications")
}

model StoreHours {
  id       String   @id @default(uuid())
  storeId  String   @map("store_id")
  weekday  Int
  opens    String?
  closes   String?
  isClosed Boolean  @default(false) @map("is_closed")

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, weekday])
  @@map("store_hours")
}

model TaxRate {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  rateBps   Int      @map("rate_bps")
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, active])
  @@map("tax_rates")
}

/// Append-only record of sensitive actions (plan §13.8).
///
/// Written by an interceptor rather than by hand at each call site, so coverage
/// does not depend on remembering. UPDATE and DELETE are revoked from the
/// application role at the grant level — this table is evidence, and evidence
/// the application can rewrite is not evidence.
model AuditLog {
  id          String        @id @default(uuid())
  actorUserId String?       @map("actor_user_id")
  storeId     String?       @map("store_id")
  severity    AuditSeverity @default(MEDIUM)
  action      String
  entityType  String        @map("entity_type")
  entityId    String?       @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?       @map("user_agent")
  requestId   String?       @map("request_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([severity, createdAt])
  @@map("audit_logs")
}

enum MediaKind {
  PRODUCT
  BRANDING
  PROOF
  SIGNATURE
  EXPORT
}

enum MediaStatus {
  PENDING
  READY
  REJECTED
}

/// Uploaded files. See plan §13.7 for the validation pipeline.
///
/// `storageKey` is always server-generated (a UUID path). The user's filename
/// is kept only as metadata and never influences where bytes are written —
/// that is the path-traversal defense.
model MediaAsset {
  id           String      @id @default(uuid())
  storeId      String?     @map("store_id")
  ownerUserId  String?     @map("owner_user_id")
  kind         MediaKind
  status       MediaStatus @default(PENDING)
  storageKey   String      @unique @map("storage_key")
  mime         String
  bytes        Int
  width        Int?
  height       Int?
  originalName String?     @map("original_name")

  /// Why a file was rejected, so the owner gets a useful message rather than
  /// a silent failure.
  rejectReason String?     @map("reject_reason")

  /// Distinguishes assets that must not be publicly served (delivery proofs,
  /// signatures) from branding and product images that are CDN-cacheable.
  isPrivate    Boolean     @default(false) @map("is_private")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([storeId, kind, status])
  @@map("media_assets")
}
