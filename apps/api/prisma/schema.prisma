// Phase 3 starting schema: identity, memberships, tenancy root.
// See docs/plan/08-database-schema.md §8.2 for the full target catalog —
// catalog/inventory/orders/payments/delivery tables land in later phases.
//
// RLS policies are NOT expressed here (Prisma doesn't model them) — they are
// added as raw SQL in a companion migration per table, per §8.6, and are
// what the Phase 3 cross-tenant isolation suite actually tests.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum UserStatus {
  ACTIVE
  LOCKED
  CLOSED
}

enum PlatformRole {
  SUPER_ADMIN
}

enum MembershipRole {
  STORE_ADMIN
  INVENTORY_MANAGER
  CLERK
  DELIVERY
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PermissionEffect {
  GRANT
  DENY
}

enum StoreStatus {
  APPROVED
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BusinessType {
  RETAIL
  RESTAURANT
  SERVICE
}

enum VerificationTokenType {
  EMAIL_VERIFY
  PW_RESET
  INVITE
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique @db.Citext
  passwordHash      String?       @map("password_hash")
  name              String
  phone             String?
  platformRole      PlatformRole? @map("platform_role")
  status            UserStatus    @default(ACTIVE)
  emailVerifiedAt   DateTime?     @map("email_verified_at")
  /// AES-256-GCM ciphertext, never the raw secret (plan §13.1).
  mfaTotpSecret     String?       @map("mfa_totp_secret")
  mfaEnabledAt      DateTime?     @map("mfa_enabled_at")
  lastLoginAt       DateTime?     @map("last_login_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  deletedAt         DateTime?     @map("deleted_at")

  memberships        StoreMembership[]
  ownedStores        Store[]             @relation("StoreOwner")
  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  authIdentities     AuthIdentity[]
  mfaRecoveryCodes   MfaRecoveryCode[]
  carts              Cart[]
  orders             Order[]
  storeRelations     CustomerStoreRelation[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  familyId   String    @map("family_id")
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  rotatedAt  DateTime? @map("rotated_at")
  revokedAt  DateTime? @map("revoked_at")
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Store {
  id                   String       @id @default(uuid())
  slug                 String       @unique @db.Citext
  name                 String
  legalName            String?      @map("legal_name")
  businessType         BusinessType @map("business_type")
  status               StoreStatus  @default(APPROVED)
  ownerUserId          String       @map("owner_user_id")
  addressLine1         String?      @map("address_line1")
  city                 String?
  state                String?
  postalCode           String?      @map("postal_code")
  country              String?
  timezone             String       @default("America/New_York")
  currency             String       @default("USD") @db.Char(3)
  branding             Json         @default("{}")
  stripeAccountId        String?   @unique @map("stripe_account_id")
  stripeChargesEnabled   Boolean   @default(false) @map("stripe_charges_enabled")
  stripePayoutsEnabled   Boolean   @default(false) @map("stripe_payouts_enabled")
  stripeDetailsSubmitted Boolean   @default(false) @map("stripe_details_submitted")
  /// What Stripe is still waiting for, verbatim, so settings can say exactly
  /// what is outstanding rather than "contact support".
  stripeRequirements     Json      @default("[]") @map("stripe_requirements")
  stripeDisabledReason   String?   @map("stripe_disabled_reason")
  stripeSyncedAt         DateTime? @map("stripe_synced_at")
  cashEnabled          Boolean      @default(true) @map("cash_enabled")

  /// Per-transaction platform fee, in basis points. NULL inherits the plan's rate.
  ///
  /// BBA publicly commits to taking no cut of a store's sales (docs/plan §18.6), so
  /// this is 0 everywhere and `application_fee_amount` is omitted from PaymentIntents
  /// entirely rather than passed as zero — a zero fee still prints a fee line on the
  /// merchant's Stripe statement, which contradicts the promise.
  ///
  /// This lives on the store as well as the plan on purpose: if a per-transaction fee
  /// is ever introduced, every store existing at that moment must be grandfathered at
  /// 0 permanently, and that requires a per-store value no future plan change can
  /// override. Setting this to a non-zero value is a trust decision, not a config one.
  platformFeeBps       Int?         @default(0) @map("platform_fee_bps")
  approvedAt           DateTime?    @map("approved_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  deletedAt            DateTime?    @map("deleted_at")

  owner       User               @relation("StoreOwner", fields: [ownerUserId], references: [id])
  memberships StoreMembership[]
  hours         StoreHours[]
  taxRates      TaxRate[]
  deliveryZones DeliveryZone[]
  categories    Category[]
  products      Product[]
  carts             Cart[]
  orders            Order[]
  customerRelations CustomerStoreRelation[]
  refunds           Refund[]
  subscription      StoreSubscription?
  coupons           Coupon[]
  billingNotices    BillingNotification[]

  dailySales DailyStoreSales[]

  @@map("stores")
}

model StoreMembership {
  id         String           @id @default(uuid())
  storeId    String           @map("store_id")
  userId     String           @map("user_id")
  role       MembershipRole
  status     MembershipStatus @default(INVITED)
  invitedBy  String?          @map("invited_by")
  acceptedAt DateTime?        @map("accepted_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  store     Store                       @relation(fields: [storeId], references: [id])
  user      User                        @relation(fields: [userId], references: [id])
  overrides MemberPermissionOverride[]

  @@unique([storeId, userId])
  @@index([userId, status])
  @@map("store_memberships")
}

model MemberPermissionOverride {
  id             String           @id @default(uuid())
  membershipId   String           @map("membership_id")
  permissionCode String           @map("permission_code")
  effect         PermissionEffect
  grantedBy      String?          @map("granted_by")
  createdAt      DateTime         @default(now()) @map("created_at")

  membership StoreMembership @relation(fields: [membershipId], references: [id])

  @@unique([membershipId, permissionCode])
  @@map("member_permission_overrides")
}

/// Single-use tokens delivered by email: address verification, password reset,
/// and staff/owner invitations.
///
/// `userId` is nullable because an invitation is sent to an email address that
/// may not have an account yet — the account is created when the invite is
/// accepted. That is also why `email` is stored here rather than being read
/// through the relation.
///
/// Only the SHA-256 hash of the token is stored, for the same reason as refresh
/// tokens: a database read must not yield usable credentials.
model VerificationToken {
  id        String                @id @default(uuid())
  userId    String?               @map("user_id")
  email     String                @db.Citext
  type      VerificationTokenType
  tokenHash String                @unique @map("token_hash")

  /// Type-specific data. INVITE carries { storeId, role, invitedBy }.
  payload   Json?

  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([email, type])
  @@map("verification_tokens")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditSeverity {
  LOW
  MEDIUM
  HIGH
}

/// Public applications from businesses wanting a store (plan §5.7).
///
/// Deliberately separate from `stores`: an application is a request from a
/// person we know nothing about yet, and most fields are unverified claims.
/// A store row only exists once a human has approved one.
model StoreApplication {
  id            String            @id @default(uuid())
  applicantName String            @map("applicant_name")
  applicantEmail String           @map("applicant_email") @db.Citext
  applicantPhone String?          @map("applicant_phone")
  businessName  String            @map("business_name")
  businessType  BusinessType      @map("business_type")
  addressLine1  String?           @map("address_line1")
  city          String?
  state         String?
  postalCode    String?           @map("postal_code")
  pitch         String?
  status        ApplicationStatus @default(PENDING)
  reviewedBy    String?           @map("reviewed_by")
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewNote    String?           @map("review_note")

  /// Set on approval. Also the idempotency guard: a retried approval finds the
  /// store already linked rather than provisioning a second one.
  storeId       String?           @unique @map("store_id")

  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("store_applications")
}

model StoreHours {
  id       String   @id @default(uuid())
  storeId  String   @map("store_id")
  weekday  Int
  opens    String?
  closes   String?
  isClosed Boolean  @default(false) @map("is_closed")

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, weekday])
  @@map("store_hours")
}

model TaxRate {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  rateBps   Int      @map("rate_bps")
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, active])
  @@map("tax_rates")
}

/// Append-only record of sensitive actions (plan §13.8).
///
/// Written by an interceptor rather than by hand at each call site, so coverage
/// does not depend on remembering. UPDATE and DELETE are revoked from the
/// application role at the grant level — this table is evidence, and evidence
/// the application can rewrite is not evidence.
model AuditLog {
  id          String        @id @default(uuid())
  actorUserId String?       @map("actor_user_id")
  storeId     String?       @map("store_id")
  severity    AuditSeverity @default(MEDIUM)
  action      String
  entityType  String        @map("entity_type")
  entityId    String?       @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?       @map("user_agent")
  requestId   String?       @map("request_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([severity, createdAt])
  @@map("audit_logs")
}

enum MediaKind {
  PRODUCT
  BRANDING
  PROOF
  SIGNATURE
  EXPORT
}

enum MediaStatus {
  PENDING
  READY
  REJECTED
}

/// Uploaded files. See plan §13.7 for the validation pipeline.
///
/// `storageKey` is always server-generated (a UUID path). The user's filename
/// is kept only as metadata and never influences where bytes are written —
/// that is the path-traversal defense.
model MediaAsset {
  id           String      @id @default(uuid())
  storeId      String?     @map("store_id")
  ownerUserId  String?     @map("owner_user_id")
  kind         MediaKind
  status       MediaStatus @default(PENDING)
  storageKey   String      @unique @map("storage_key")
  mime         String
  bytes        Int
  width        Int?
  height       Int?
  originalName String?     @map("original_name")

  /// Why a file was rejected, so the owner gets a useful message rather than
  /// a silent failure.
  rejectReason String?     @map("reject_reason")

  /// Distinguishes assets that must not be publicly served (delivery proofs,
  /// signatures) from branding and product images that are CDN-cacheable.
  isPrivate    Boolean     @default(false) @map("is_private")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([storeId, kind, status])
  @@map("media_assets")
}

/// Delivery zones (FR-STORE-04). Radius-based only for the Illinois launch —
/// polygons are the advanced option and are not needed for a metro rollout.
model DeliveryZone {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  name          String
  centerLat     Float    @map("center_lat")
  centerLng     Float    @map("center_lng")
  radiusMeters  Int      @map("radius_meters")
  feeCents      Int      @map("fee_cents")
  minOrderCents Int      @default(0) @map("min_order_cents")
  etaMinutes    Int      @map("eta_minutes")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId, active])
  @@map("delivery_zones")
}

/// Social sign-in links. A user may have several (Google today, others later).
model AuthIdentity {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  provider    String
  providerUid String   @map("provider_uid")
  email       String?  @db.Citext
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("auth_identities")
}

/// Single-use MFA recovery codes (FR-AUTH-08).
///
/// Stored hashed like any other credential: these are the last way into an
/// account when a phone is lost, so a database read must not yield usable ones.
model MfaRecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// One level of subcategory is allowed; depth is capped by a trigger.
/// Deeper trees are a merchandising rabbit hole for a corner shop, and every
/// extra level multiplies the navigation the owner has to maintain.
model Category {
  id        String    @id @default(uuid())
  storeId   String    @map("store_id")
  parentId  String?   @map("parent_id")
  name      String
  slug      String
  position  Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  store    Store      @relation(fields: [storeId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, active, position])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")
  categoryId  String?       @map("category_id")
  name        String
  slug        String
  brand       String?
  description String?
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  store    Store            @relation(fields: [storeId], references: [id])
  category Category?        @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]

  @@unique([storeId, slug])
  @@index([storeId, status, categoryId])
  @@map("products")
}

/// The sellable unit. Every product has at least one — a product with no
/// variant has no price and cannot be bought, so the default is created with
/// the product rather than left to the owner to remember.
model ProductVariant {
  id             String    @id @default(uuid())
  productId      String    @map("product_id")
  /// Denormalised from the product so RLS and the per-store SKU uniqueness
  /// constraint can both be expressed without a join.
  storeId        String    @map("store_id")
  sku            String?
  barcode        String?
  /// e.g. { "size": "Large", "colour": "Blue" }. Empty for a single-variant product.
  attrs          Json      @default("{}")
  priceCents     Int       @map("price_cents")
  compareAtCents Int?      @map("compare_at_cents")
  costCents      Int?      @map("cost_cents")
  isDefault      Boolean   @default(false) @map("is_default")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevel StockLevel?
  cartItems  CartItem[]

  @@index([productId])
  @@index([storeId, barcode])
  @@map("product_variants")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  storeId      String   @map("store_id")
  mediaAssetId String   @map("media_asset_id")
  alt          String?
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([storeId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

/// Current stock state per variant. Derived from the movement ledger by a
/// trigger — application code never writes `onHand` directly.
model StockLevel {
  variantId    String   @id @map("variant_id")
  storeId      String   @map("store_id")
  onHand       Int      @default(0) @map("on_hand")
  /// Held for orders that are placed but not yet paid or fulfilled. Available
  /// stock is `onHand - reserved`.
  reserved     Int      @default(0)
  reorderPoint Int?     @map("reorder_point")
  reorderQty   Int?     @map("reorder_qty")
  /// Off by default: a store selling made-to-order items should not have
  /// checkout blocked by a count nobody maintains.
  tracked      Boolean  @default(false)
  updatedAt    DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("stock_levels")
}

/// Append-only stock ledger. Grants withhold UPDATE and DELETE, and a trigger
/// refuses them as well.
model StockMovement {
  id          String            @id @default(uuid())
  storeId     String            @map("store_id")
  variantId   String            @map("variant_id")
  type        StockMovementType
  qtyDelta    Int               @map("qty_delta")
  reasonCode  String?           @map("reason_code")
  note        String?
  orderId     String?           @map("order_id")
  actorUserId String?           @map("actor_user_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([storeId, variantId, createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  RECEIVE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  COUNT
}

// ---------------------------------------------------------------------------
// Shopping
// ---------------------------------------------------------------------------

model Cart {
  id         String     @id @default(uuid())
  storeId    String     @map("store_id")
  userId     String?    @map("user_id")
  /// Set for guests instead of `userId`; exactly one of the two is present.
  sessionKey String?    @map("session_key")
  status     CartStatus @default(ACTIVE)
  expiresAt  DateTime   @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  store Store      @relation(fields: [storeId], references: [id])
  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]

  @@map("carts")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

model CartItem {
  id              String   @id @default(uuid())
  cartId          String   @map("cart_id")
  storeId         String   @map("store_id")
  variantId       String   @map("variant_id")
  qty             Int
  /// What the shopper saw when adding. Display only — checkout re-quotes.
  priceAtAddCents Int      @map("price_at_add_cents")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// Per-store counters, incremented inside the order transaction to produce
/// human-readable order numbers without a global bottleneck.
model StoreCounter {
  storeId String @map("store_id")
  key     String
  value   BigInt @default(0)

  @@id([storeId, key])
  @@map("store_counters")
}

model Order {
  id          String       @id @default(uuid())
  storeId     String       @map("store_id")
  orderNumber String       @map("order_number")
  /// NULL for a walk-in POS sale with no account attached.
  customerId  String?      @map("customer_id")
  channel     OrderChannel @default(ONLINE)
  fulfillment Fulfillment
  status      OrderStatus  @default(PENDING)

  subtotalCents    Int    @map("subtotal_cents")
  discountCents    Int    @default(0) @map("discount_cents")
  taxCents         Int    @default(0) @map("tax_cents")
  deliveryFeeCents Int    @default(0) @map("delivery_fee_cents")
  tipCents         Int    @default(0) @map("tip_cents")
  totalCents       Int    @map("total_cents")
  currency         String @default("USD")

  /// Snapshot, not a reference: the receipt must still be correct after the
  /// customer edits their address book.
  deliveryAddress Json?   @map("delivery_address")
  customerNote    String? @map("customer_note")
  contactEmail    String? @map("contact_email")
  contactPhone    String? @map("contact_phone")

  couponId   String? @map("coupon_id")
  /// Snapshotted alongside the id: a receipt should still show which code was
  /// used after the coupon itself is deleted.
  couponCode String? @map("coupon_code")

  /// Lets a guest reach their own order later without an account.
  guestToken String? @map("guest_token")

  /// Client-supplied retry key. Unique per store, so a double-clicked Place
  /// Order returns the first order instead of creating a second.
  idempotencyKey String? @map("idempotency_key")

  placedAt  DateTime  @default(now()) @map("placed_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  store    Store                @relation(fields: [storeId], references: [id])
  customer User?                @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  history     OrderStatusHistory[]
  payments    Payment[]
  coupon      Coupon?            @relation(fields: [couponId], references: [id])
  redemptions CouponRedemption[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status, placedAt])
  /// For the sales rollup, which wants a date range across every status that
  /// counts as trade. The index above leads with status, so that query becomes
  /// a bitmap of eight scans; this one makes it a single range scan.
  @@index([storeId, placedAt], map: "orders_store_placed")
  @@index([customerId, placedAt])
  @@map("orders")
  delivery Delivery?
}

enum OrderChannel {
  ONLINE
  POS
}

enum Fulfillment {
  PICKUP
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

/// Line snapshots. Deliberately denormalised so a receipt stays readable after
/// the product is renamed, repriced or deleted.
model OrderItem {
  id             String  @id @default(uuid())
  orderId        String  @map("order_id")
  storeId        String  @map("store_id")
  variantId      String? @map("variant_id")
  productName    String  @map("product_name")
  variantAttrs   Json    @default("{}") @map("variant_attrs")
  sku            String?
  unitPriceCents Int     @map("unit_price_cents")
  qty            Int
  lineTotalCents Int     @map("line_total_cents")
  taxCents       Int     @default(0) @map("tax_cents")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  storeId     String       @map("store_id")
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  /// NULL means the system did it — the expiry sweeper or a webhook.
  actorUserId String?      @map("actor_user_id")
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                    String          @id @default(uuid())
  storeId               String          @map("store_id")
  orderId               String          @map("order_id")
  provider              PaymentProvider
  stripePaymentIntentId String?         @map("stripe_payment_intent_id")
  amountCents           Int             @map("amount_cents")
  /// Always zero. The platform takes no cut of any sale.
  applicationFeeCents   Int             @default(0) @map("application_fee_cents")
  status                PaymentStatus
  cashReceivedBy        String?         @map("cash_received_by")
  cashReceivedAt        DateTime?       @map("cash_received_at")
  failureReason         String?         @map("failure_reason")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@index([orderId])
  @@map("payments")
}

enum PaymentProvider {
  STRIPE
  CASH
}

enum PaymentStatus {
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

/// A store's view of one of its customers. Maintained when an order confirms.
model CustomerStoreRelation {
  id                 String    @id @default(uuid())
  storeId            String    @map("store_id")
  userId             String    @map("user_id")
  firstOrderAt       DateTime? @map("first_order_at")
  orderCount         Int       @default(0) @map("order_count")
  lifetimeSpendCents BigInt    @default(0) @map("lifetime_spend_cents")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([storeId, userId])
  @@map("customer_store_relations")
}

// ---------------------------------------------------------------------------
// Payments (Stripe)
// ---------------------------------------------------------------------------

/// Every webhook the provider sends, recorded before it is acted on.
///
/// Stripe delivers at least once and replays on failure, sometimes out of
/// order. The unique `eventId` is what turns a replay into a no-op.
model StripeEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique @map("event_id")
  type        String
  accountId   String?   @map("account_id")
  storeId     String?   @map("store_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")
  /// Set when a handler threw, so a failure is visible rather than lost.
  error       String?

  @@index([storeId, receivedAt])
  @@map("stripe_events")
}

model Refund {
  id             String       @id @default(uuid())
  storeId        String       @map("store_id")
  paymentId      String       @map("payment_id")
  amountCents    Int          @map("amount_cents")
  reasonCode     String?      @map("reason_code")
  note           String?
  status         RefundStatus @default(PENDING)
  stripeRefundId String?      @map("stripe_refund_id")
  actorUserId    String?      @map("actor_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  store   Store   @relation(fields: [storeId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([paymentId])
  @@map("refunds")
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// Transactional outbox (plan §12.8).
///
/// Written inside the transaction that caused the event, so an event can never
/// describe a change that rolled back. A relay in `apps/worker` publishes
/// unpublished rows in id order and marks them.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  storeId     String?   @map("store_id")
  aggregateId String?   @map("aggregate_id")
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  /// Counted so a poisonous event can be parked rather than blocking the relay.
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([storeId, createdAt])
  @@map("outbox_events")
}

// ---------------------------------------------------------------------------
// SaaS billing — the platform charging the store (plan §18.5a)
// ---------------------------------------------------------------------------

/// SaaS plans. v2.0 ships exactly one row.
///
/// The table and the `planCode` FK exist so a second tier is later a row
/// rather than a migration — but no plan-gating or upgrade logic ships.
model Plan {
  code           String   @id
  name           String
  priceCents     Int      @map("price_cents")
  interval       String   @default("month")
  trialDays      Int      @default(30) @map("trial_days")
  /// Zero, and a CHECK constraint keeps it there. BBA takes no cut of sales.
  platformFeeBps Int      @default(0) @map("platform_fee_bps")
  limits         Json     @default("{}")
  stripePriceId  String?  @map("stripe_price_id")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscriptions StoreSubscription[]

  @@map("plans")
}

/// A store's subscription to the platform.
///
/// Not to be confused with Connect: this is the store owner paying us, where
/// Connect is the store being paid by its own customers.
model StoreSubscription {
  id                   String             @id @default(uuid())
  storeId              String             @unique @map("store_id")
  planCode             String             @map("plan_code")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  status               SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?          @map("trial_ends_at")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  /// When the account first went unpaid. The grace period runs from here, so
  /// it does not restart on every card retry.
  pastDueSince         DateTime?          @map("past_due_since")
  /// Set when suspended for non-payment, so it can be told apart from a
  /// suspension a Super Admin applied by hand.
  suspendedAt          DateTime?          @map("suspended_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id])
  plan  Plan  @relation(fields: [planCode], references: [code])

  @@map("store_subscriptions")
}

/// One thing somebody has been told, waiting in their inbox. Communications
/// happen in the app rather than by mail — see docs/adr/0001.
model Notification {
  id      String  @id @default(uuid())
  userId  String  @map("user_id")
  /// Which shop it concerns. Null for anything about the account itself.
  /// Cascades: a notice about a shop that no longer exists says nothing.
  storeId String? @map("store_id")
  event   String
  title   String
  body    String
  /// Where to go to act on it. Without one it is a diary entry.
  link    String?

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "notifications_feed")
  @@map("notifications")
}

/// Somebody's choice about one kind of message on one channel. Absence means
/// the default, which is on — see the migration for why defaults are not rows.
model NotificationPreference {
  id        String              @id @default(uuid())
  userId    String              @map("user_id")
  /// Null means everywhere; a store id narrows the choice to one shop.
  storeId   String?             @map("store_id")
  event     String
  channel   NotificationChannel
  enabled   Boolean
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, event], map: "notification_preferences_lookup")
  @@map("notification_preferences")
}

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
  SMS
}

/// What is known about getting one order to somebody's door. The order's own
/// status remains the answer to "where is it" — this carries the rest.
model Delivery {
  id        String @id @default(uuid())
  storeId   String @map("store_id")
  orderId   String @unique @map("order_id")

  driverUserId String?   @map("driver_user_id")
  assignedAt   DateTime? @map("assigned_at")
  assignedBy   String?   @map("assigned_by")
  pickedUpAt   DateTime? @map("picked_up_at")
  deliveredAt  DateTime? @map("delivered_at")

  /// Private-prefix media: a photograph of somebody's doorway, and their
  /// handwriting. Served by short-lived presigned URL, never publicly.
  proofMediaAssetId     String? @map("proof_media_asset_id")
  signatureMediaAssetId String? @map("signature_media_asset_id")

  failureReason DeliveryFailureReason? @map("failure_reason")
  failureNote   String?                @map("failure_note")
  failedAt      DateTime?              @map("failed_at")
  /// A second attempt is ordinary; a fourth is a conversation with the customer.
  attempts      Int                    @default(0)

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([driverUserId, deliveredAt], map: "deliveries_driver")
  @@map("deliveries")
}

enum DeliveryFailureReason {
  NOBODY_HOME
  ADDRESS_NOT_FOUND
  REFUSED
  UNSAFE_TO_LEAVE
  VEHICLE_PROBLEM
  OTHER
}

/// One physical count of a shop: open, entered, then posted as variances.
model CountSession {
  id       String             @id @default(uuid())
  storeId  String             @map("store_id")
  name     String
  status   CountSessionStatus @default(OPEN)
  openedBy String             @map("opened_by")
  openedAt DateTime           @default(now()) @map("opened_at")
  postedBy String?            @map("posted_by")
  postedAt DateTime?          @map("posted_at")
  note     String?

  lines CountLine[]

  @@index([storeId, status])
  @@map("count_sessions")
}

/// What was found on one shelf, against what was expected at that moment.
model CountLine {
  id          String   @id @default(uuid())
  sessionId   String   @map("session_id")
  storeId     String   @map("store_id")
  variantId   String   @map("variant_id")
  /// Captured when the line was entered, not at posting — otherwise a sale
  /// made during the count is folded into the variance.
  expectedQty Int      @map("expected_qty")
  countedQty  Int      @map("counted_qty")
  note        String?
  countedBy   String   @map("counted_by")
  countedAt   DateTime @default(now()) @map("counted_at")

  session CountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, variantId], map: "count_lines_one_per_variant")
  @@index([storeId], map: "count_lines_store")
  @@map("count_lines")
}

enum CountSessionStatus {
  OPEN
  POSTED
  ABANDONED
}

/// Which worker last ran a scheduled job, and when. The row *is* the lease:
/// claiming a pass means winning a conditional update of it.
model ScheduledJobRun {
  jobName       String   @id @map("job_name")
  lastStartedAt DateTime @map("last_started_at")
  /// host:pid of the claimant. Read by humans only — nothing keys off it.
  owner         String

  @@map("scheduled_job_runs")
}

/// One dunning email that was sent. Append-only: the record of what a store
/// was told, and when.
model BillingNotification {
  id           String       @id @default(uuid())
  storeId      String       @map("store_id")
  /// Which unpaid episode this belongs to, so a store that lapses twice is
  /// warned twice. See the migration for why this is not keyed on the store.
  pastDueSince DateTime     @map("past_due_since")
  stage        DunningStage
  /// The address at the time of sending, not the owner's address today.
  sentTo       String       @map("sent_to")
  sentAt       DateTime     @default(now()) @map("sent_at")

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId, pastDueSince, stage], map: "billing_notifications_once")
  @@index([storeId, pastDueSince], map: "billing_notifications_episode")
  @@map("billing_notifications")
}

enum DunningStage {
  PAYMENT_FAILED
  GRACE_REMINDER
  FINAL_WARNING
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

// ---------------------------------------------------------------------------
// Coupons (FR-CAT-06)
// ---------------------------------------------------------------------------

model Coupon {
  id               String     @id @default(uuid())
  storeId          String     @map("store_id")
  /// citext: shoppers type these by hand off a flyer.
  code             String     @db.Citext
  kind             CouponKind
  /// Basis points for PERCENT, cents for FIXED. One column because a coupon is
  /// never both, and two nullable ones would let it be neither.
  value            Int
  minOrderCents    Int        @default(0) @map("min_order_cents")
  startsAt         DateTime?  @map("starts_at")
  endsAt           DateTime?  @map("ends_at")
  maxRedemptions   Int?       @map("max_redemptions")
  perCustomerLimit Int?       @map("per_customer_limit")
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  store       Store               @relation(fields: [storeId], references: [id])
  redemptions CouponRedemption[]
  orders      Order[]

  @@map("coupons")
}

enum CouponKind {
  PERCENT
  FIXED
}

/// Append-only: the usage count depends on it.
model CouponRedemption {
  id          String   @id @default(uuid())
  couponId    String   @map("coupon_id")
  storeId     String   @map("store_id")
  orderId     String   @map("order_id")
  /// NULL for a guest — the per-customer limit can only bind someone we can
  /// identify, which is a real limitation rather than an oversight.
  userId      String?  @map("user_id")
  amountCents Int      @map("amount_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

/// One store's trading day, summarised (plan §8.2, Phase 10).
///
/// Reports read this rather than aggregating `orders`, because "how did we do
/// last quarter" is otherwise a scan of every order the shop has ever taken,
/// and it gets slower every day they stay open.
///
/// `date` is the *store's* date, derived with its own timezone. Bucketing on
/// UTC would file a Chicago bakery's last hour of Tuesday trade under
/// Wednesday. See the migration for what each money column includes, and what
/// it deliberately leaves on `orders`.
model DailyStoreSales {
  storeId String   @map("store_id")
  date    DateTime @db.Date

  ordersCount       Int    @default(0) @map("orders_count")
  grossCents        BigInt @default(0) @map("gross_cents")
  discountsCents    BigInt @default(0) @map("discounts_cents")
  taxCents          BigInt @default(0) @map("tax_cents")
  refundsCents      BigInt @default(0) @map("refunds_cents")
  netCents          BigInt @default(0) @map("net_cents")
  posOrdersCount    Int    @default(0) @map("pos_orders_count")
  onlineOrdersCount Int    @default(0) @map("online_orders_count")

  computedAt DateTime @default(now()) @map("computed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, date])
  @@map("daily_store_sales")
}
