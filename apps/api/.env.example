NODE_ENV=development
PORT=3001

# Homebrew Postgres defaults to your macOS username as the DB superuser.
# Replace <user> with the output of `whoami`, or set your own role.
DATABASE_URL="postgresql://<user>@localhost:5432/bba_dev?schema=public"

# The role the API actually runs as, and the one the tests use (created by
# migration 00000000000001_rls_policies). MUST be the RLS-restricted `bba_app`, not
# the schema owner: superusers and table owners bypass row-level security, so
# an API on the owner connection has every tenant-isolation policy disabled
# while behaving normally and passing its tests. Migrations use DATABASE_URL;
# the server uses this. They are different identities on purpose.
DATABASE_URL_APP="postgresql://bba_app@localhost:5432/bba_dev?schema=public"

REDIS_URL="redis://localhost:6379"

# Ed25519 keypair for signing access tokens. Generate a fresh pair per environment;
# in production these come from Secrets Manager, never from a file in the repo.
#
#   npm run keygen
#
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="bba"
JWT_AUDIENCE="bba-api"

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cookies are always httpOnly + SameSite=Lax. Secure is dropped only for local http.
COOKIE_SECURE=false

# Must match where the web app actually runs. It is both the CORS allowlist and
# the base for links in outbound email — a mismatch produces invitation and
# password-reset links that 404, which is easy to miss because nothing errors.
# The web app runs on 3100 (see .claude/launch.json). This is not only CORS:
# every link in outbound mail is built from it, so a wrong value here sends
# invitations, password resets and billing warnings to a dead port.
WEB_ORIGIN="http://localhost:3100"

# Public base URL for uploaded images (product photos, store logos, banners).
# Leave unset in development: the API then serves .storage/public itself at
# /media/public and builds URLs against its own origin. Set it to the CDN in
# front of the object store in production, which also switches the local
# static route off. Do NOT point it at WEB_ORIGIN — the files live next to the
# API, and the web app has no route that serves them.
# MEDIA_BASE_URL="https://cdn.example.com/media"

# Checks new passwords against the Have I Been Pwned k-anonymity range API.
# Leave false locally and in CI so tests don't depend on an outbound call.
PASSWORD_BREACH_CHECK=false

# ── Stripe (Phase 8) ────────────────────────────────────────────────────────
# Optional. Without these the platform runs cash-only: card checkout is simply
# not offered, rather than failing when a customer tries to pay.
#
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
#
# From `stripe listen --forward-to localhost:3001/api/v1/webhooks/stripe`,
# which prints a signing secret for local development. The production value is
# per-endpoint and comes from the Stripe dashboard.
# STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Google OAuth (FR-AUTH-07) ───────────────────────────────────────────────
# From https://console.cloud.google.com → APIs & Services → Credentials →
# OAuth 2.0 Client ID (type: Web application).
#
# The authorised redirect URI must be the WEB origin, not this API:
#
#   http://localhost:3100/auth/oauth/google/callback
#
# Google redirects the browser, and the browser only ever talks to the Next.js
# BFF — which forwards the code here for exchange. The client secret therefore
# stays in this file and never reaches the web app or the browser.
#
# Optional: without these, "Continue with Google" is not offered and password
# sign-in is unaffected.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
