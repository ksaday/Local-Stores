NODE_ENV=development
PORT=3001

# Homebrew Postgres defaults to your macOS username as the DB superuser.
# Replace <user> with the output of `whoami`, or set your own role.
DATABASE_URL="postgresql://<user>@localhost:5432/bba_dev?schema=public"

# The RLS-restricted role the app connects as in tests (created by migration
# 00000000000001_rls_policies). Never point this at a superuser — RLS is bypassed
# for superusers, which would make the isolation suite pass for the wrong reason.
DATABASE_URL_APP="postgresql://bba_app@localhost:5432/bba_dev?schema=public"

REDIS_URL="redis://localhost:6379"

# Ed25519 keypair for signing access tokens. Generate a fresh pair per environment;
# in production these come from Secrets Manager, never from a file in the repo.
#
#   npm run keygen
#
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""
JWT_ISSUER="bba"
JWT_AUDIENCE="bba-api"

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cookies are always httpOnly + SameSite=Lax. Secure is dropped only for local http.
COOKIE_SECURE=false

# Must match where the web app actually runs. It is both the CORS allowlist and
# the base for links in outbound email — a mismatch produces invitation and
# password-reset links that 404, which is easy to miss because nothing errors.
WEB_ORIGIN="http://localhost:3000"

# Checks new passwords against the Have I Been Pwned k-anonymity range API.
# Leave false locally and in CI so tests don't depend on an outbound call.
PASSWORD_BREACH_CHECK=false
