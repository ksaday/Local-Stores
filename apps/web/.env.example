# Where the API is reachable from the Next.js server. Server-side only: the
# browser never calls the API directly, it goes through this app's BFF routes.
API_BASE_URL="http://localhost:3001/api/v1"

# Keep in sync with WEB_ORIGIN in apps/api/.env, or emailed links will point at
# the wrong port.
PORT=3000

# Tracing. Unset OTEL_EXPORTER_OTLP_ENDPOINT disables it entirely.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_CONSOLE=
OTEL_BASELINE_RATIO=0.05
OTEL_SLOW_REQUEST_MS=600
# Required, and silently costs you the BFF->API hop if missing: Next suppresses
# fetch spans without it, so the two services trace separately and look fine.
NEXT_OTEL_VERBOSE=1
