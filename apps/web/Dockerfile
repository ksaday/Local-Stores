# The Next.js BFF.
#
# Built from the repository root:
#   docker build -f apps/web/Dockerfile -t bba-web .
#
# The output is Next's standalone build — a traced server carrying only the
# modules the app actually reaches. Without it the image would ship the whole
# workspace's node_modules, including a Prisma client and an OpenTelemetry SDK
# the web app never loads.

FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV NODE_ENV=production

# ── Dependencies ─────────────────────────────────────────────────────────────
FROM base AS deps
# tsconfig.base.json is extended by every workspace tsconfig, so a build
# without it fails at the first `tsc` with TS5083 — a missing-file error that
# names a path, not a missing COPY. Found by replaying this build's file set
# outside a container rather than by discovering it in CI.
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN npm ci --ignore-scripts

# ── Build ────────────────────────────────────────────────────────────────────
FROM deps AS build
ENV NODE_ENV=production
COPY packages/shared packages/shared
COPY apps/web apps/web

# @bba/shared is TypeScript source in the repo and compiled output in the
# image, so it has to be built before Next resolves it.
RUN npm run build --workspace @bba/shared

# Build-time, not runtime: Next inlines anything NEXT_PUBLIC_* into the client
# bundle when it compiles, so these must be present now. A value supplied only
# at container start arrives after the bundle that needed it was written.
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}

RUN npm run build --workspace @bba/web

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM base AS runtime

# The standalone output keeps the monorepo's shape — apps/web, packages,
# node_modules — because tracing was rooted at the workspace root. Copied as a
# whole so those paths still resolve.
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./

# Static assets are deliberately NOT part of the standalone output, and this is
# the line people forget. Without it the server starts, answers, and every page
# loads with no CSS and no JavaScript — a failure that looks like a styling bug
# rather than a missing copy.
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static

USER node
EXPOSE 3000

# server.js is generated by the standalone build and reads PORT and HOSTNAME.
# HOSTNAME must be 0.0.0.0: the default binds loopback only, so the container
# would answer from inside itself and refuse every health check from outside.
ENV PORT=3000 HOSTNAME=0.0.0.0

CMD ["node", "apps/web/server.js"]
