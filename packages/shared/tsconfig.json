{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // CommonJS to match the NestJS API's output. The `.js` specifiers in source
    // resolve correctly under both module systems, so this stays consumable
    // from the Next.js app too.
    "module": "CommonJS",
    "moduleResolution": "Node"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules", "src/**/*.test.ts"]
}
